# Anthropic API
ANTHROPIC_API_KEY=your_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# Deliberation parameters
NUM_CANDIDATE_STATEMENTS=8
MAX_DELIBERATION_ROUNDS=5

# Clustering parameters
MIN_CLUSTER_APPROVAL=0.6
MAX_CLUSTERS=5

# Database
DATABASE_URL=sqlite:///consensus.db

# API
API_HOST=0.0.0.0
API_PORT=8000
